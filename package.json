{
  "name": "uthyrning-match-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "test:web": "vitest run --root web",
    "build:web": "next build web --webpack",
    "dev:web": "next dev web --webpack",
    "check": "npm test && npm run typecheck:web && npm run test:web && npm run build:web"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.19.43",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^4.1.12",
    "vite": "^7.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8"
  }
}
